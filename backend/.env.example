# Copy to .env and fill in real values. Never commit .env.
API_PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# JWT signing secret. Generate with: openssl rand -base64 48
TOKEN_KEY=

# Browser origins allowed to call this API, comma separated.
# Defaults to http://localhost:3000 plus PUBLIC_BASE_URL, so local development
# needs nothing here. Set it when the frontend is hosted somewhere else.
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example

# Absolute base used to build citation links. Must be the frontend's origin.
# PUBLIC_BASE_URL=https://your-frontend.example
