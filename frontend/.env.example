# Origin of the API, scheme and host only, no trailing slash and no /api.
# Both the REST client and the socket client are built from this.
#
# Leave it unset for local development: the app falls back to
# http://localhost:5002 in development and to the hosted API in a production
# build. Set it when the backend moves.
#
# Create React App inlines REACT_APP_* at build time, so this is baked into the
# bundle. Changing it means rebuilding, not restarting.
# REACT_APP_API_ORIGIN=https://your-api.example
