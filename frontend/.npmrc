# react-diff-viewer@3.1.1 declares a peer range of React 15 or 16. The app runs
# React 17, which it works fine with, but npm 7 and later treat the mismatch as
# a hard error and refuse to install at all.
#
# Without this, a clean `npm install` or `npm ci` fails on the very first step
# for anyone cloning the repo.
legacy-peer-deps=true
